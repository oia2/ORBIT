# ORBIT server configuration.
# Copy to .env for local overrides; docker compose supplies these to the app service.

# PostgreSQL connection string. Required — the server refuses to start without it.
DATABASE_URL=postgres://orbit:orbit@localhost:5432/orbit

# Port the Fastify server listens on.
PORT=3000

# development | production | test. In production the server also serves dist/.
NODE_ENV=development
