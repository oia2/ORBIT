{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    /*
     * tasks.md T003 called for `nodenext`, but the shared domain under `src/`
     * is written for bundler resolution (extensionless, directory-index
     * imports) and the server ships as a Vite SSR bundle. `nodenext` would
     * force `.js` suffixes across `src/` — a repo-wide rewrite to describe a
     * runtime that never sees these paths. Recorded in traceability.md.
     */
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "vite.server.config.ts", "vitest.server-tz.config.ts"]
}
